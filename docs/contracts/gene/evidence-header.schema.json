{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Exxec/Project-BridgeForge/docs/contracts/gene/evidence-header.schema.json#1",
  "title": "bridgeforge-gene-evidence schema 1",
  "type": "object",
  "required": [
    "evidence",
    "schema_version",
    "kind",
    "gene",
    "produced_by",
    "created_at",
    "build",
    "inputs",
    "verdict"
  ],
  "properties": {
    "evidence": {
      "const": "bridgeforge-gene-evidence"
    },
    "schema_version": {
      "const": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "gene": {
      "type": "object",
      "required": [
        "identity",
        "schema_version"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema_version": {
          "type": "integer",
          "not": {
            "enum": [
              1,
              2,
              3
            ]
          }
        }
      }
    },
    "produced_by": {
      "type": "object",
      "required": [
        "tool",
        "version"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "build": {
      "type": "object",
      "properties": {
        "game_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "path",
          "sha256"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "(^/|\\\\|:|(^|/)\\.{1,2}(/|$)|//|^\\s|\\s$)"
            }
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN",
        "UNKNOWN"
      ]
    }
  }
}
